#!/usr/bin/env python3
"""공용 랩 노드 중에서 지금 돌리기 좋은 곳을 골라, 남에게 폐 안 되게 실행한다.

    nslab status                      # 전 노드 상태 한눈에
    nslab pick --cores 8              # 어디서 돌릴지만 판정
    nslab run --cores 8 -- python sim.py
    nslab jobs                        # 누가 뭘 돌리는 중인지

노드는 ~/.ssh/config 의 Host 별칭으로 지정한다 (NSLAB_NODES 환경변수로 교체 가능).
표준 라이브러리만 쓴다.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import datetime as dt
import json
import os
import shlex
import socket
import subprocess
import sys

NODES = os.environ.get("NSLAB_NODES", "node0,node1,node2,node3,node26").split(",")

# 랩 합의 — 노드마다 쓸 수 있는 CPU 번호가 정해져 있다.
# 앞쪽 번호는 시스템·GUI 몫이고, 뒤쪽은 다른 사람이 쓰도록 비워 둔다.
# 여기 없는 노드는 제한 없음으로 본다.
CPU_ALLOC = {
    "node0": (2, 17),    # 전체 0-19
    "node1": (2, 3),     # 전체 0-7
    "node2": (2, 15),    # 전체 0-19
    "node3": (2, 11),    # 전체 0-19
    "node26": (5, 19),   # 전체 0-23
}


def alloc(node: str):
    """(lo, hi, 폭). 지정이 없으면 (None, None, None)."""
    r = CPU_ALLOC.get(node)
    return (r[0], r[1], r[1] - r[0] + 1) if r else (None, None, None)
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8"]
JOBDIR = "~/nslab-jobs"
LOGDIR = "~/nslab-logs"

# 노드에서 한 번에 긁어오는 값들. uid>=1000 인 사람만 '사용자'로 센다.
PROBE = r"""
echo "host=$(hostname)"
echo "cores=$(nproc)"
awk '{print "load1="$1; print "load5="$2}' /proc/loadavg
free -m | awk '/Mem:/{print "mem_total="$2; print "mem_avail="$7}'
df -P -BG "$HOME" 2>/dev/null | awk 'NR==2{gsub("G","",$4); print "disk_avail="$4}'
ps -eo uid=,user= | awk '$1>=1000 && $2!~/^(gdm|gnome|rtkit|colord|geoclue)/{print $2}' \
  | sort -u | tr '\n' ',' | sed 's/^/users=/;s/,$//'
echo
ps -eo pcpu=,etimes=,comm= --sort=-pcpu | awk '$1>50 && $2>600 {n++} END{print "hogs="n+0}'
nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total \
  --format=csv,noheader,nounits 2>/dev/null | sed 's/, */,/g;s/^/gpu=/'
"""


def probe(node: str) -> dict:
    out = {"node": node, "ok": False, "gpus": [], "error": None}
    try:
        r = subprocess.run(SSH + [node, "bash -s"], input=PROBE, capture_output=True,
                           text=True, timeout=25)
        if r.returncode != 0:
            out["error"] = (r.stderr.strip().splitlines() or ["ssh 실패"])[-1]
            return out
    except subprocess.TimeoutExpired:
        out["error"] = "응답 없음 (timeout)"
        return out
    for line in r.stdout.splitlines():
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k == "gpu":
            # node0 처럼 드라이버가 깨진 노드는 nvidia-smi 가 에러 문장을 stdout 으로 뱉는다
            parts = [x.strip() for x in v.split(",")]
            if len(parts) != 4:
                out["gpu_error"] = v.strip()
                continue
            try:
                out["gpus"].append({"index": int(parts[0]), "util": int(parts[1]),
                                    "used": int(parts[2]), "total": int(parts[3])})
            except ValueError:
                out["gpu_error"] = v.strip()
        elif k == "users":
            out["users"] = [u for u in v.split(",") if u]
        elif k == "host":
            out["hostname"] = v
        else:
            try:
                out[k] = float(v) if "." in v else int(v)
            except ValueError:
                out[k] = v
    out["ok"] = "cores" in out
    if out["ok"]:
        # load5 를 쓰는 이유: load1 은 방금 끝난 작업에 속는다
        out["free_cores"] = max(0.0, out["cores"] - out.get("load5", 0.0))
        out["free_gpus"] = [g for g in out["gpus"] if g["util"] < 20 and g["used"] < 2000]
    return out


def survey(nodes: list[str]) -> list[dict]:
    with cf.ThreadPoolExecutor(max_workers=len(nodes)) as ex:
        return list(ex.map(probe, nodes))


def rank(nodes: list[dict], cores: int, ram_gb: int, gpus: int, gpu_ram_gb: int):
    """우선도 판정. 왜 그 노드인지 설명 가능해야 하므로 규칙을 순서대로 적용한다."""
    ok, rejected = [], []
    for n in nodes:
        if not n["ok"]:
            rejected.append((n, n["error"] or "상태 확인 실패"))
            continue
        usable = [g for g in n["free_gpus"] if g["total"] - g["used"] >= gpu_ram_gb * 1024]
        lo, hi, width = alloc(n["node"])
        if width is not None and cores > width:
            rejected.append((n, f"할당 CPU {lo}-{hi} ({width}코어) < 요청 {cores}"))
            continue
        if n["free_cores"] < cores:
            rejected.append((n, f"여유 코어 {n['free_cores']:.1f} < 요청 {cores}"))
            continue
        if n.get("mem_avail", 0) / 1024 < ram_gb:
            rejected.append((n, f"여유 RAM {n.get('mem_avail',0)/1024:.0f}GB < 요청 {ram_gb}GB"))
            continue
        if gpus and len(usable) < gpus:
            rejected.append((n, f"쓸 수 있는 GPU {len(usable)}장 < 요청 {gpus}장"))
            continue
        score = n["free_cores"] - cores + (n.get("mem_avail", 0) / 1024 - ram_gb) / 32
        why = []
        if not gpus and n["gpus"]:
            # CPU 작업이 GPU 노드를 차지하면 GPU 쓸 사람이 갈 데가 없다
            score -= 3 * len(n["gpus"])
            why.append(f"GPU {len(n['gpus'])}장짜리라 CPU 작업에는 감점")
        if gpus:
            score += 2 * len(usable)
        others = n.get("users", [])
        if n.get("hogs", 0):
            score -= 2 * n["hogs"]
            why.append(f"장시간 CPU 점유 프로세스 {n['hogs']}개")
        if others:
            score -= 1
            why.append(f"동시 사용자 {len(others)}명: {', '.join(others)}"
                       + " (공용 계정이라 남의 job 일 수 있음)")
        ok.append({"node": n, "score": score, "gpus": usable[:gpus], "why": why})
    ok.sort(key=lambda x: -x["score"])
    return ok, rejected


def fmt_status(n: dict) -> str:
    if not n["ok"]:
        return f"  {n['node']:<7} ✗ {n['error']}"
    g = n["gpus"]
    gtxt = "GPU 없음"
    if n.get("gpu_error"):
        gtxt = "GPU 이상"
    if g:
        free = len(n["free_gpus"])
        gtxt = f"GPU {free}/{len(g)}장 여유"
    lo, hi, width = alloc(n["node"])
    atxt = f"CPU {lo}-{hi}({width})" if width else "CPU 제한없음"
    return (f"  {n['node']:<7} {n.get('hostname',''):<17} {atxt:<14} "
            f"코어 {n['free_cores']:5.1f}/{n['cores']:<3.0f} 여유   "
            f"RAM {n.get('mem_avail',0)/1024:5.0f}/{n.get('mem_total',0)/1024:<4.0f}GB   "
            f"{gtxt:<14} "
            f"디스크 {n.get('disk_avail','?')}GB"
            + (f"   ⚠ 장시간점유 {n['hogs']}" if n.get("hogs") else ""))


def cmd_status(a):
    nodes = survey(a.nodes)
    print(f"GNU NS-lab 노드 상태  ({dt.datetime.now():%Y-%m-%d %H:%M})\n")
    for n in nodes:
        print(fmt_status(n))
    busy = [n for n in nodes if n["ok"] and n.get("users")]
    if busy:
        print("\n접속 중인 사용자")
        for n in busy:
            print(f"  {n['node']:<7} {', '.join(n['users'])}")
    print("\n* 여유 코어 = 전체 코어 - load5.")
    print("* CPU a-b 는 랩에서 정한 할당 범위입니다. nslab run 은 taskset 으로 여기 안에만 붙입니다.")
    return 0


def cmd_pick(a, quiet=False):
    nodes = survey(a.nodes)
    ok, rejected = rank(nodes, a.cores, a.ram, a.gpu, a.gpu_ram)
    if not ok:
        print("지금 조건을 만족하는 노드가 없습니다.", file=sys.stderr)
        for n, why in rejected:
            print(f"  {n['node']:<7} {why}", file=sys.stderr)
        print("\n요청을 줄이거나(--cores), 잠시 뒤 다시 보세요.", file=sys.stderr)
        return None
    best = ok[0]
    if not quiet:
        n = best["node"]
        print(f"→ {n['node']}  ({n.get('hostname','')})")
        print(f"   요청 코어 {a.cores} · RAM {a.ram}GB"
              + (f" · GPU {a.gpu}장" if a.gpu else "")
              + f"  /  여유 코어 {n['free_cores']:.1f}, RAM {n.get('mem_avail',0)/1024:.0f}GB")
        lo, hi, width = alloc(n["node"])
        if width:
            print(f"   할당 CPU {lo}-{hi} ({width}코어) 안에서만 돕니다")
        if best["gpus"]:
            print(f"   쓸 GPU: {', '.join(str(g['index']) for g in best['gpus'])}")
        for w in best["why"]:
            print(f"   · {w}")
        if len(ok) > 1:
            alts = ", ".join(f"{o['node']['node']}({o['score']:.1f})" for o in ok[1:4])
            print(f"   차선: {alts}")
        for nn, why in rejected:
            print(f"   ✗ {nn['node']}: {why}")
    return best


def cmd_pick_cli(a):
    return 0 if cmd_pick(a) else 1


def cmd_run(a):
    if not a.command:
        print("실행할 명령이 없습니다. `nslab run --cores 8 -- python sim.py` 처럼 쓰세요.",
              file=sys.stderr)
        return 2
    best = cmd_pick(a)
    if not best:
        return 1
    node = best["node"]["node"]
    name = a.name or f"job-{dt.datetime.now():%m%d-%H%M%S}"
    gpu_ids = ",".join(str(g["index"]) for g in best["gpus"])

    env = [f"OMP_NUM_THREADS={a.cores}", f"OPENBLAS_NUM_THREADS={a.cores}",
           f"MKL_NUM_THREADS={a.cores}", f"NUMEXPR_NUM_THREADS={a.cores}"]
    if a.gpu:
        env.append(f"CUDA_VISIBLE_DEVICES={gpu_ids}")
    elif best["node"]["gpus"]:
        env.append("CUDA_VISIBLE_DEVICES=")   # CPU 작업이 GPU 를 잡지 않게

    lo, hi, width = alloc(node)
    pin = f"taskset -c {lo}-{hi} " if width else ""
    wd = a.workdir
    remote_wd = ('"$HOME"' + (shlex.quote(wd[1:]) if len(wd) > 1 else "")
                 if wd.startswith("~") else shlex.quote(wd))
    user_cmd = " ".join(shlex.quote(c) for c in a.command)
    claim_body = json.dumps(
        {"name": name, "by": f"{os.environ.get('USER','?')}@{socket.gethostname()}",
         "started": dt.datetime.now().isoformat(timespec="seconds"),
         "cores": a.cores, "cpus": f"{lo}-{hi}" if width else "all",
         "gpu": gpu_ids or None, "cmd": user_cmd},
        ensure_ascii=False)[:-1]  # 닫는 중괄호를 떼고 원격에서 pid 를 붙인다
    remote = f"""
mkdir -p {JOBDIR} {LOGDIR}
cd {remote_wd} || exit 1
{' '.join(env)} nohup {pin}nice -n {a.nice} {user_cmd} > {LOGDIR}/{name}.log 2>&1 &
pid=$!
printf '%s, "pid": %s}}\n' {shlex.quote(claim_body)} "$pid" > {JOBDIR}/{name}.json
echo "pid=$pid"
"""
    print(f"\n실행 계획  [{node}]  nice {a.nice} · 스레드 {a.cores}"
          + (f" · CPU {lo}-{hi} 고정" if width else " · CPU 제한없음")
          + (f" · GPU {gpu_ids}" if gpu_ids else " · GPU 미사용"))
    print(f"  cd {a.workdir} && {user_cmd}")
    print(f"  로그 {LOGDIR}/{name}.log")
    if a.dry_run:
        print("\n(--dry-run 이라 실행하지 않았습니다)")
        return 0
    r = subprocess.run(SSH + [node, "bash -s"], input=remote, capture_output=True, text=True)
    if r.returncode != 0:
        print(r.stderr.strip(), file=sys.stderr)
        return 1
    print(f"\n{r.stdout.strip()}  —  {name} 시작됨")
    print(f"로그 보기:  ssh {node} tail -f {LOGDIR}/{name}.log")
    print(f"중단:      ssh {node} pkill -f {shlex.quote(a.command[-1])}")
    return 0


def cmd_jobs(a):
    def one(node):
        r = subprocess.run(SSH + [node, f"cat {JOBDIR}/*.json 2>/dev/null"],
                           capture_output=True, text=True, timeout=20)
        return node, [l for l in r.stdout.splitlines() if l.strip()]
    print("등록된 작업 (nslab run 으로 띄운 것만 보입니다)\n")
    found = 0
    with cf.ThreadPoolExecutor(max_workers=len(a.nodes)) as ex:
        for node, lines in ex.map(one, a.nodes):
            for l in lines:
                try:
                    j = json.loads(l)
                except json.JSONDecodeError:
                    continue
                found += 1
                print(f"  {node:<7} {j.get('name','?'):<18} {j.get('by','?'):<22} "
                      f"{j.get('started','?')}  코어{j.get('cores','?')}"
                      + (f" GPU{j['gpu']}" if j.get("gpu") else ""))
                print(f"          {j.get('cmd','')}")
    if not found:
        print("  (없음)")
    print("\n* 여기 없는 작업도 노드에서 돌고 있을 수 있습니다. `nslab status` 의 load 를 같이 보세요.")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="nslab", description="공용 랩 노드 오케스트레이션")
    ap.add_argument("--nodes", default=",".join(NODES),
                    type=lambda s: s.split(","), help="ssh 별칭 쉼표 구분")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="전 노드 상태").set_defaults(fn=cmd_status)

    def add_req(p):
        p.add_argument("--cores", type=int, default=4,
                       help="필요한 코어 수 (기본 4). 노드 할당 범위를 넘으면 그 노드는 탈락")
        p.add_argument("--ram", type=int, default=8, help="필요한 RAM GB (기본 8)")
        p.add_argument("--gpu", type=int, default=0, help="필요한 GPU 장수")
        p.add_argument("--gpu-ram", type=int, default=8, help="GPU 한 장당 필요 VRAM GB")

    p = sub.add_parser("pick", help="어디서 돌릴지 판정만"); add_req(p)
    p.set_defaults(fn=cmd_pick_cli)

    p = sub.add_parser("run", help="골라서 공손하게 실행"); add_req(p)
    p.add_argument("--name", help="작업 이름 (로그·claim 파일명)")
    p.add_argument("--workdir", default="~", help="원격 작업 디렉터리")
    p.add_argument("--nice", type=int, default=10, help="nice 값 (기본 10)")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("command", nargs=argparse.REMAINDER, help="-- 뒤에 실행할 명령")
    p.set_defaults(fn=cmd_run)

    sub.add_parser("jobs", help="등록된 작업 목록").set_defaults(fn=cmd_jobs)

    a = ap.parse_args()
    if getattr(a, "command", None) and a.command and a.command[0] == "--":
        a.command = a.command[1:]
    return a.fn(a) or 0


if __name__ == "__main__":
    sys.exit(main())
