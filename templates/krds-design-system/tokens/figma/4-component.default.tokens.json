    "medium": {
      "padding": {
        "$type": "number",
        "$value": "{padding-card.medium}"
      }
    },
    "small": {
      "padding": {
        "$type": "number",
        "$value": "{padding-card.small}"
      }
    },
    "xsmall": {
      "padding": {
        "$type": "number",
        "$value": "{padding-card.xsmall}"
      }
