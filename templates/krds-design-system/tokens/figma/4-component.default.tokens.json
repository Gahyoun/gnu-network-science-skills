    "neutral": {
      "fill": {
        "$type": "color",
        "$value": "{surface.gray-subtler}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.gray-light}"
      }
    },
    "secondary": {
      "fill": {
        "$type": "color",
        "$value": "{surface.secondary-subtler}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.secondary}"
      }
    }
