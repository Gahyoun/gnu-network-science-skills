      "padding-x": {
        "$type": "number",
        "$value": "{number.8}"
      },
      "font-size": {
        "$type": "number",
        "$value": "{font-size.label.medium}"
      },
      "radius": {
        "$type": "number",
        "$value": "{radius.medium}"
      }
    },
    "small": {
      "height": {
        "$type": "number",
        "$value": "{height.small}"
      },
      "padding-x": {
