    "height": {
      "$type": "number",
      "$value": "{number.20}"
    },
    "gap-breadcrumb": {
      "$type": "number",
      "$value": "{gap.header-breadcrumb}"
    }
  },
  "nav": {
    "width": {
      "$type": "number",
      "$value": "{grid.side-nav-width}"
    },
    "gap-contents": {
      "$type": "number",
      "$value": "{gap.contents-right}"
    },
