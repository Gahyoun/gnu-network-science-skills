  "badge": {
    "radius": {
      "$type": "number",
      "$value": "{radius.small}"
    },
    "height": {
      "$type": "number",
      "$value": "{number.10}"
    },
    "padding-x": {
      "$type": "number",
      "$value": "{number.5}"
    },
    "font-size": {
      "$type": "number",
      "$value": "{font-size.label.xsmall}"
    }
